DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=<host_de_la_DB> 
DB_POSTGRESDB_PORT=<puerto_de_la_DB>      
DB_POSTGRESDB_DATABASE=<nombre_de_la_DB> # POSTGRES_DB
DB_POSTGRESDB_USER=<usuario_de_la_DB> # POSTGRES_USER
DB_POSTGRESDB_PASSWORD=<contraseña_de_la_DB> # POSTGRES_PASSWORD

N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=<usuario_seguro>
N8N_BASIC_AUTH_PASSWORD=<contraseña_segura>

N8N_HOST=<tu_dominio_o_subdominio>.onrender.com
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_TUNNEL_URL=https://<tu_dominio_o_subdominio>.onrender.com/

N8N_LOG_LEVEL=info # Ajusta a warn o error si quieres menos verbosidad.
