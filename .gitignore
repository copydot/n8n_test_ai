# Archivos de entorno y secretos
.env                          # Contiene variables de entorno locales (credenciales de DB, etc.)
.env.production               # Si tuvieras un archivo de env específico para prod, también ignorarlo

# Dependencias de Node.js
node_modules/                

# Archivos de log
*.log                         

# Archivos temporales o del sistema operativo
.DS_Store                     # Archivos de macOS
Thumbs.db                     # Archivos de Windows

# Archivos de configuración de editores/IDE (VS Code, etc.)
.vscode/                      # Configuraciones específicas de VS Code

# Directorios temporales de Docker Compose
.docker/                     


# Archivos de backup o generados automáticamente que no son parte del código fuente
*.bak
*.tmp